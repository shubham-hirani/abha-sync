# ═══ Supabase ═══════════════════════════════════════════
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ═══ PostgreSQL ══════════════════════════════════════════
POSTGRES_USER=abhasync
POSTGRES_PASSWORD=abhasync_pass
POSTGRES_DB=abhasync_db

# (Do NOT override DATABASE_URL here — docker-compose constructs it automatically)

# ═══ FastAPI App ═════════════════════════════════════════
SECRET_KEY=change-this-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# ═══ Frontend ════════════════════════════════════════════
# Leave empty for docker (nginx proxy handles /api routing)
VITE_API_URL=
